
def build(target):
    cmd = './configure --prefix=%s/%s --disable-lcms1 --disable-lcms2 --disable-tiff' % (target.work_dir_cscript(), target.install_prefix)
    if target.platform == 'osx':
        cmd += ' --disable-dependency-tracking'

    target.command(cmd)
    target.command('make -j2 V=1')
    target.command('make install')
