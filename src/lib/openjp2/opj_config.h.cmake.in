#ifndef OPJ_CONFIG_H_INCLUDED
#define OPJ_CONFIG_H_INCLUDED

/* create opj_config.h for CMake */

/*--------------------------------------------------------------------------*/
/* OpenJPEG Versioning                                                      */

/* Version number. */
#define OPJ_VERSION_MAJOR @OPENJPEG_VERSION_MAJOR@
#define OPJ_VERSION_MINOR @OPENJPEG_VERSION_MINOR@
#define OPJ_VERSION_BUILD @OPENJPEG_VERSION_BUILD@

/*--------------------------------------------------------------------------*/
/* CtrlMovie fork features                                                  */

/* Defined when the library is built with the Metal GPU tier-1 encoder
 * (OPJ_USE_METAL=ON), i.e. when the METAL_T1=YES encoder option is effective. */
#cmakedefine OPJ_HAVE_METAL_T1

/* Defined when the library is built with the Metal GPU tier-1 decoder
 * (OPJ_USE_METAL=ON), i.e. when the METAL_T1=YES decoder option
 * (opj_decoder_set_extra_options()) is effective. */
#cmakedefine OPJ_HAVE_METAL_T1_DECODE

#endif
