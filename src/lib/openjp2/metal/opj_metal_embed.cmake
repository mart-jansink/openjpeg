# Generates the C header embedding the Metal T1 shader source.
# Usage: cmake -DMETAL_SRC=... -DLUTS=... -DOUT_METAL=... -DOUT_HEADER=...
#              [-DSYMBOL=name] -P opj_metal_embed.cmake
# SYMBOL (default opj_metal_t1_src) names the array; its length is
# SYMBOL_len.
# The content of t1_luts.h replaces the /*@OPJ_T1_LUTS@*/ marker so that the
# GPU uses exactly the CPU tables. The combined shader is also written to
# OUT_METAL for inspection (xcrun metal -c can compile it offline).
if(NOT SYMBOL)
  set(SYMBOL opj_metal_t1_src)
endif()
get_filename_component(_srcname "${METAL_SRC}" NAME)
file(READ "${METAL_SRC}" _src)
file(READ "${LUTS}" _luts)
string(FIND "${_src}" "/*@OPJ_T1_LUTS@*/" _pos)
if(_pos LESS 0)
  message(FATAL_ERROR "OPJ_T1_LUTS marker not found in ${METAL_SRC}")
endif()
string(REPLACE "/*@OPJ_T1_LUTS@*/" "${_luts}" _src "${_src}")
file(WRITE "${OUT_METAL}" "${_src}")
file(READ "${OUT_METAL}" _hex HEX)
string(LENGTH "${_hex}" _hexlen)
math(EXPR _len "${_hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){20})" "\\1\n" _hex "${_hex}")
file(WRITE "${OUT_HEADER}.tmp"
  "/* Generated by opj_metal_embed.cmake from ${_srcname} and t1_luts.h */\n"
  "static const unsigned char ${SYMBOL}[] = {\n${_hex}\n};\n"
  "static const unsigned long ${SYMBOL}_len = ${_len}UL;\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different
  "${OUT_HEADER}.tmp" "${OUT_HEADER}")
